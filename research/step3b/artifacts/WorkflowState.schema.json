        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "detection_id": {
          "title": "Detection Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "advance",
            "retreat"
          ],
          "title": "Direction",
          "type": "string"
        },
        "latest_observation_seconds": {
          "minimum": 0,
