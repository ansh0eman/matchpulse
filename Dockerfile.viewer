# Build locally for review. This file does not provision or publish infrastructure.
FROM node:24-bookworm-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MATCHPULSE_ROOT=/app \
    MATCHPULSE_VIEWER_BUNDLE=/app/backend/output/viewer-bundle MATCHPULSE_WEB_DIST=/app/web-dist
COPY backend/pyproject.toml backend/requirements-viewer.txt backend/requirements-viewer-lock.txt /app/backend/
COPY backend/src /app/backend/src
RUN pip install --no-cache-dir --upgrade pip==26.2.2 && pip install --no-cache-dir -e /app/backend -r /app/backend/requirements-viewer-lock.txt
COPY backend/output/viewer-bundle /app/backend/output/viewer-bundle
COPY research/step25/artifacts/selected.json /app/research/step25/artifacts/selected.json
COPY research/step3b/artifacts/live-foundry-validation.json research/step3b/artifacts/foundry-authenticated-proof.json /app/research/step3b/artifacts/
COPY research/step3c/artifacts/recorded-foundry-trace.json /app/research/step3c/artifacts/
COPY research/step3c/artifacts/recorded-goal-partial.broadcast.json research/step3c/artifacts/recorded-goal-partial.state.json /app/research/step3c/artifacts/
COPY research/step3d/artifacts/foundry-goal.broadcast.json research/step3d/artifacts/foundry-goal.state.json research/step3d/artifacts/foundry-goal.trace.json research/step3d/artifacts/foundry-capture.json /app/research/step3d/artifacts/
COPY --from=web /web/dist /app/web-dist
RUN useradd --uid 10001 --create-home studio && chown -R studio:studio /app
USER studio
EXPOSE 8010
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8010/api/health')"
CMD ["uvicorn","matchpulse.viewer.api:app","--host","0.0.0.0","--port","8010","--no-access-log"]
